# copiar para .env (chmod 600). Nenhum valor real aqui.
EVOLUTION_URL=http://127.0.0.1:8080
EVOLUTION_INSTANCE=vigia
EVOLUTION_INSTANCE_APIKEY=            # chave DA INSTÂNCIA (hash.apikey do create); a global não entra
VIGIA_PORT=8120
VIGIA_TOKEN=                          # cookie do painel local (openssl rand -hex 24); sem ele o painel não sobe
# VIGIA_TOKEN_ENVIO NÃO entra aqui: mora em ~/.vigia-envio.env (chmod 600), lido só pelo painel (R-9)
FRENTES_URL=http://127.0.0.1:8110
FRENTES_TOKEN=
DONO_WHATSAPP=55DDNNNNNNNNN
AVISO_INSTANCIA=                      # nome da instância da Evolution do bot que manda o aviso semanal (nunca o número pessoal)
# Só para quem manda o aviso por um cofre local de tokens (serviço em 127.0.0.1:8000 que guarda a chave do bot). Sem as
# duas linhas o Greg não procura cofre nenhum e o aviso sai direto pela Evolution do bot (AVISO_EVOLUTION_URL).
# AVISO_COFRE_ARQUIVO=~/.meu-cofre/.env   # arquivo onde está o token do cofre; a pasta dele fica negada à IA
# AVISO_COFRE_CHAVE=MEU_COFRE_TOKEN       # nome da variável dentro desse arquivo
VIGIA_CONVERSAS_DO_SISTEMA=           # jids separados por vírgula que a IA não lê (ex.: o bot dos avisos); o painel segue mostrando (D-49)
