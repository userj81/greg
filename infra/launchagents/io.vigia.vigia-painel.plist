<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Modelo: /REPO_RAIZ e /REPO_HOME são substituídos por bin/instalar-launchagent.sh. Sem segredo: o .env é lido pelos scripts. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.vigia.vigia-painel</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3</string>
		<string>-P</string>
		<string>/REPO_RAIZ/app/server.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/REPO_RAIZ</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/REPO_HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>PYTHONPATH</key>
		<string>/REPO_RAIZ</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>ProcessType</key>
	<string>Standard</string>
	<key>StandardOutPath</key>
	<string>/REPO_HOME/Library/Logs/vigia-painel.out.log</string>
	<key>StandardErrorPath</key>
	<string>/REPO_HOME/Library/Logs/vigia-painel.err.log</string>
</dict>
</plist>
