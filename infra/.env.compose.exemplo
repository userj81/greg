# Exemplo de infra/.env.compose (copie para infra/.env.compose, chmod 600; o real nunca vai ao git).
# Gerar cada valor: openssl rand -hex 24   (só hexadecimal: sem '=' nem aspas, não quebra sed/psql).
# Valores abaixo são placeholders; bin/evolution.sh recusa subir enquanto começarem com TROQUE.
EVOLUTION_GLOBAL_KEY=TROQUE_gerar_com_openssl_rand_hex_24
POSTGRES_PASSWORD=TROQUE_gerar_com_openssl_rand_hex_24
VIGIA_RO_PASSWORD=TROQUE_gerar_com_openssl_rand_hex_24
VIGIA_LIMPEZA_PASSWORD=TROQUE_gerar_com_openssl_rand_hex_24
